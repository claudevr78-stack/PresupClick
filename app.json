{
  "expo": {
    "name": "PresupClick",
    "slug": "presupclick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "ios": {
      "supportsTablet": false,
      "requiresFullScreen": true,
      "bundleIdentifier": "com.maisonlaville.presupclick",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIDeviceFamily": [1],
        "NSCameraUsageDescription": "PresupClick uses your camera to take photos of the construction site so the AI can analyze them and generate an accurate quote automatically.",
        "NSPhotoLibraryUsageDescription": "PresupClick accesses your photo library so you can select existing photos of the construction site for AI analysis and quote generation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f0f"
      },
      "package": "com.maisonlaville.presupclick",
      "edgeToEdgeEnabled": true
    },
    "owner": "lavill",
    "extra": {
      "eas": {
        "projectId": "7bc26d76-23be-4d40-a872-39bff05671c8"
      }
    },
    "plugins": [
      "expo-localization",
      "expo-mail-composer"
    ]
  }
}